--- a/modules/PileUpMerger.h
+++ b/modules/PileUpMerger.h
@@ -57,6 +57,11 @@ private:
   Double_t fOutputBeamSpotX;
   Double_t fOutputBeamSpotY;
 
+  // opt-in per-event reseeding of gRandom (see Init())
+  Bool_t fPerEventSeed;
+  ULong64_t fSeedBase;
+  Long64_t fEventCounter;
+
   std::unique_ptr<DelphesTF2> fFunction; //!
 
   std::unique_ptr<DelphesPileUpReader> fReader; //!
