shower=OFF
done
# Added here, on top of the JetClass2 cards this was copied from: upstream sets no beam
# energy at all, so it came silently from MadGraph's run_card default. Pinned to 13 TeV
# to match the Run-2 conditions and the jetclass2sb QCD, and so an upstream default
# change cannot move it unnoticed.
set ebeam1 6500
set ebeam2 6500
set pdlabel lhapdf
set lhaid 315000
set use_syst False
set nevents $NEVENT
set iseed $SEED
set param_card mass 25 $1
set pt_min_pdg 25:$2
set param_card mass 37 $3
set param_card width 37 $4
set param_card mass 35 $3
set param_card width 35 $4
done
