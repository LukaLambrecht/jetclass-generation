# outputs and results
**output_*
*.png
*.root
hlteff/*.json
testing/test-production-time/*.txt

# job directories (submit files + condor logs).
condor_*

# CRAB working directories and related stuff
crab/production

# ROOT / ACLiC compiled artifacts (machine- and ROOT-version-specific;
# regenerated automatically by `root -b -q 'macro.C++(...)'`)
*.so
*.d
*_ACLiC_dict_rdict.pcm
*_ACLiC_dict.cxx
*_ACLiC_dict.h
*_ACLiC_linkdef.h
*_ACLiC_mainC
*_ACLiC_map.in
*_ACLiC_map.out

# MadGraph/Pythia8 run-time artifacts, in case a process is generated by hand
# directly inside a gen_configs/ directory instead of via run.sh's isolated
# per-job workdir
gen_configs/*/*/proc/
gen_configs/*/*/mg5_step2.dat
gen_configs/*/*/py.py
gen_configs/*/*/*.lhe.gz
gen_configs/*/*/events.hepmc
gen_configs/*/*/py8_main
gen_configs/*/*/py8.dat.bak

# The FullSim ntuplizer binary, if build.sh is ever run inside the repository
# instead of in a job's own scratch directory
fullsim_analyzers/makeNtuplesFullSim

# OS / editor stuff
.DS_Store
*.swp
__pycache__/
*.pyc
