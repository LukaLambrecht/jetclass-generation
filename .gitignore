# outputs and results
**output_*
*.png
*.root
hlteff/curves_qcd.json
testing/test-generation-time/*.txt

# job directories
condor
condor_*

# ROOT / ACLiC compiled artifacts (machine- and ROOT-version-specific;
# regenerated automatically by `root -b -q 'macro.C++(...)'`)
*.so
*.d
*_ACLiC_dict_rdict.pcm
*_ACLiC_dict.cxx
*_ACLiC_dict.h
*_ACLiC_linkdef.h
*_ACLiC_mainC
*_ACLiC_map.in
*_ACLiC_map.out

# Generated ROOT output files, e.g. from following the makeNtuples.C README
# example or a manual test run inside delphes_analyzers/ or a gen_configs/
# process directory. The bundled example Delphes file stays tracked.
*.root
!delphes_analyzers/events_delphes_higgs2p_example.root

# MadGraph/Pythia8 run-time artifacts, in case a process is generated by hand
# directly inside a gen_configs/ directory instead of via run.sh's isolated
# per-job workdir
gen_configs/*/*/proc/
gen_configs/*/*/mg5_step2.dat
gen_configs/*/*/py.py
gen_configs/*/*/*.lhe.gz
gen_configs/*/*/events.hepmc
gen_configs/*/*/py8_main
gen_configs/*/*/py8.dat.bak

# OS / editor cruft
.DS_Store
*.swp
__pycache__/
*.pyc
